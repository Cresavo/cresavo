{
  "name": "booking-lab-se",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "admin:manage": "node --env-file=.env --import tsx scripts/admin.mts",
    "demo:record": "node --env-file=.env scripts/record-demo.mjs",
    "demo:seed": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "demo:seed:capacity": "node --env-file=.env --import tsx scripts/seed-capacity.ts",
    "demo": "node scripts/demo.mjs",
    "dev": "node --env-file-if-exists=.env scripts/server.mjs --dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env ./node_modules/@playwright/test/cli.js test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "mcp": "tsx --env-file=.env src/mcp/server.ts",
    "mcp:client": "tsx --env-file=.env src/mcp/client.ts",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e:production": "node --env-file=.env scripts/run-production-e2e.mjs",
    "agent-keys": "node --env-file-if-exists=.env --import tsx scripts/agent-keys.mts",
    "agent:proof": "node --import tsx scripts/agentprov/run.mts",
    "test:pair": "node --import tsx scripts/integration/run.mts",
    "ai:eval": "node --env-file-if-exists=.env --import tsx scripts/ai-eval.mts",
    "qa": "node qa/run-all.mjs",
    "test:concept": "playwright test --config playwright.concept.config.ts",
    "concept:mcp-demo": "node --env-file-if-exists=.env --import tsx scripts/concept-mcp-demo.mts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "lucide-react": "1.72.0",
    "luxon": "^3.7.2",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.0.0",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.1.0"
  }
}
