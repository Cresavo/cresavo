generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Service {
  id String @id
  businessId String
  name String
  duration Int
  priceOre Int
  buffer Int @default(0)
  active Boolean @default(true)
  version Int @default(1)
  bookings Booking[]
  campaigns Campaign[]
}
model Booking {
  id String @id @default(cuid())
  businessId String
  staffId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  customerName String
  customerEmail String
  customerId String?
  contactRemovedAt DateTime? @db.Timestamptz(3)
  customer Customer? @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  serviceName String @default("")
  priceOre Int @default(0)
  duration Int @default(0)
  buffer Int @default(0)
  status String @default("confirmed")
  version Int @default(1)
  initialStartsAt DateTime? @db.Timestamptz(3)
  initialEndsAt DateTime? @db.Timestamptz(3)
  events BookingEvent[]
  capacityDecisions CapacityDecision[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  idempotencyKey String?
  requestHash String?
  clientKey String?
  emailCapKey String?
  agentBooking AgentBooking?
  @@unique([businessId, idempotencyKey])
  @@unique([businessId, id])
  @@index([businessId, status, startsAt, id])
  @@index([businessId, customerEmail, createdAt])
  @@index([businessId, clientKey, createdAt])
  @@index([businessId, emailCapKey, createdAt])
  @@index([businessId, customerId, startsAt, id])
}
model Customer {
  id String @id @default(cuid())
  businessId String
  name String
  email String
  phone String?
  archived Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  bookings Booking[]
  contactRemovedAt DateTime? @db.Timestamptz(3)
  dataActions CustomerDataAction[]
  @@unique([businessId, id])
  @@index([businessId, archived, name, id])
}
model Staff {
  id String @id @default(cuid())
  businessId String
  name String
  active Boolean @default(true)
  version Int @default(1)
  serviceIds String[]
  weekly Json
  exceptions Json @default("[]")
  @@index([businessId, active])
}

model CustomerDataAction {
  id String @id @default(cuid())
  businessId String
  customerId String
  actorId String
  action String
  bookingCount Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  actor AdminUser @relation(fields: [businessId, actorId], references: [businessId, id], onDelete: Restrict)
  @@index([businessId, customerId, createdAt, id])
}

model BookingEvent {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  action String
  actorKind String
  actorId String
  previousStart DateTime? @db.Timestamptz(3)
  previousEnd DateTime? @db.Timestamptz(3)
  previousStaffId String?
  nextStart DateTime? @db.Timestamptz(3)
  nextEnd DateTime? @db.Timestamptz(3)
  nextStaffId String?
  @@index([bookingId, createdAt])
}

model WorkspaceRequest {
  id String @id @default(cuid())
  businessId String
  key String
  requestHash String
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([businessId, key])
}

// Local synthetic card channel only; not a customer identity/session table.
model CardBookingAttempt {
  businessId String
  scope String
  requestId String @db.Uuid
  payload Json
  outcome String @default("pending")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([businessId, scope, requestId])
  @@index([businessId, scope, createdAt, requestId])
}
model Campaign {
  id String @id @default(cuid())
  businessId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  title String
  discountPercent Int
  validFrom String
  validUntil String
  published Boolean @default(false)
  capacityDecision CapacityDecision?
  @@unique([businessId, id])
}

model CapacityDecision {
  id String @id @default(cuid())
  businessId String
  bookingId String
  booking Booking @relation(fields: [businessId, bookingId], references: [businessId, id], onDelete: Restrict, map: "CapacityDecision_booking_fk")
  sourceVersion Int
  outcome String
  campaignId String? @unique
  campaign Campaign? @relation(fields: [businessId, campaignId], references: [businessId, id], onDelete: Restrict, map: "CapacityDecision_campaign_fk")
  payloadHash String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([businessId, bookingId, sourceVersion])
  @@unique([businessId, campaignId])
}

model AdminSession {
  id String @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userId String?
  user AdminUser? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
}

model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  businessId String
  active Boolean @default(true)
  credentialVersion Int @default(1)
  sessions AdminSession[]
  dataActions CustomerDataAction[]
  @@unique([businessId, id])
}

model RateLimitBucket {
  key String @id
  generation String
  expiresAt DateTime @db.Timestamptz(3)
  count Int
  @@index([expiresAt])
}

// Agent API v1 credentials. Only a SHA-256 digest of the high-entropy key is
// stored; the plaintext key is shown once by scripts/agent-keys.mts.
model AgentApiKey {
  id String @id @default(cuid())
  businessId String
  clientId String
  client AgentClient @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  agentName String
  ownerName String
  ownerContact String
  keyPrefix String @unique
  keyHash String @unique
  scopes String[]
  // Provenance shown on /live: demo-script | registered-client | verified-agent-proof.
  kind String @default("registered-client")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([businessId, revokedAt])
}

// Which agent key created a booking. Object-level authorisation for status/cancel.
model AgentBooking {
  bookingId String @id
  keyId String
  businessId String
  clientId String
  mandateId String? @unique
  client AgentClient @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  nativeBookingId String? @unique
  booking Booking? @relation(fields: [businessId, nativeBookingId], references: [businessId, id], onDelete: Restrict)
  mandate AgentMandate? @relation(fields: [businessId, mandateId, clientId], references: [businessId, id, clientId], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([keyId, createdAt])
  @@unique([businessId, bookingId])
  @@unique([businessId, nativeBookingId])
  @@unique([businessId, mandateId, clientId])
  @@index([businessId, clientId, createdAt])
}

// Stable identity; credential rotation never transfers booking ownership.
model AgentClient {
  id String @id
  businessId String
  active Boolean @default(true)
  keys AgentApiKey[]
  bookings AgentBooking[]
  mandates AgentMandate[]
  proposals AgentProposal[]
  sandboxSession SandboxSession?
  @@unique([businessId, id])
}

model SandboxSession {
  id String @id @db.Uuid
  businessId String @unique
  clientId String @unique
  client AgentClient @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  generation Int
  expiresAt DateTime @db.Timestamptz(3)
  apiRequests Int @default(0)
  audit SandboxAudit[]
  @@unique([businessId, clientId], map: "SandboxSession_client_scope_key")
  @@index([generation, expiresAt])
}

model SandboxAudit {
  id String @id @default(cuid())
  sessionId String @db.Uuid
  session SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event String
  outcome String
  @@index([sessionId])
}

// Bounded operator authority or synthetic lab customer consent. No real identity proof.
model AgentMandate {
  id String @id @default(cuid())
  businessId String
  clientId String
  client AgentClient @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  serviceId String
  staffId String
  locationId String @default("demo-location")
  scheduleId String
  validFrom DateTime @db.Timestamptz(3)
  validUntil DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  maxPriceOre Int
  currency String @default("SEK")
  origin String
  originReference String
  proposalHash String?
  verifiedVia String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  booking AgentBooking?
  partnerAttempt PartnerBookingAttempt?
  proposal AgentProposal?
  @@unique([businessId, id, clientId])
  @@index([businessId, clientId, createdAt])
}

// Public-safe agent activity for /live: no customer fields, no key material.
model AgentApiEvent {
  id String @id @default(cuid())
  keyId String
  businessId String
  action String
  outcome String
  serviceName String?
  staffName String?
  startsAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([businessId, createdAt, id])
}

// One-use synthetic customer consent. Only the digest of the link is stored.
model AgentProposal {
  id String @id @default(cuid())
  businessId String
  clientId String
  client AgentClient @relation(fields: [businessId, clientId], references: [businessId, id], onDelete: Restrict)
  serviceId String
  serviceVersion Int
  serviceName String
  staffId String
  staffName String
  locationId String
  scheduleId String
  startsAt DateTime @db.Timestamptz(3)
  duration Int
  priceOre Int
  proposalHash String
  tokenHash String @unique
  consentDelivery String?
  smsOtpRequired Boolean @default(false)
  phoneHash String?
  phoneMask String?
  otpHash String?
  otpExpiresAt DateTime? @db.Timestamptz(3)
  otpAttempts Int @default(0)
  otpLastSentAt DateTime? @db.Timestamptz(3)
  otpVerifiedAt DateTime? @db.Timestamptz(3)
  status String @default("pending")
  expiresAt DateTime @db.Timestamptz(3)
  mandateId String? @unique
  mandate AgentMandate? @relation(fields: [businessId, mandateId, clientId], references: [businessId, id, clientId], onDelete: Restrict, map: "AgentProposal_mandate_fk")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([businessId, mandateId, clientId])
  @@index([businessId, clientId, createdAt])
}

// Independent, redacted operator audit. No customer or credential columns.
model AgentAuditEvent {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  businessId String
  event String
  outcome String
  clientId String?
  keyId String?
  scopes String[]
  route String?
  tool String?
  requestId String
  proposalId String?
  mandateId String?
  bookingId String?
  @@index([businessId, createdAt, id])
  @@index([proposalId])
  @@index([mandateId])
  @@index([bookingId])
  @@index([requestId])
}

// Durable reservation before a non-transactional provider call. No contact data.
model PartnerBookingAttempt {
  idempotencyKey String @id
  mandateId String @unique
  businessId String
  clientId String
  providerId String
  bodyHash String
  mandate AgentMandate @relation(fields: [businessId, mandateId, clientId], references: [businessId, id, clientId], onDelete: Restrict, map: "PartnerBookingAttempt_mandate_fk")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([businessId, mandateId, clientId])
}

model PairWorkspace {
  id          String @id @default(uuid())
  ownerHash   String @unique
  ipKey       String
  seedDay     String
  version     Int @default(1)
  revision    Int @default(1)
  snapshot    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  hardExpiry  DateTime
  codes       PairCode[]
  grants      PairGrant[]
  tokens      PairToken[]
  proposals   PairProposal[]
  @@index([expiresAt])
  @@index([ipKey])
}

model PairClient {
  id           String @id
  name         String
  redirects    String[]
  expiresAt    DateTime
  @@index([expiresAt])
}

model PairCode {
  hash         String @id
  consent      Boolean
  workspaceId  String
  workspace    PairWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  clientName   String
  redirectUri  String
  challenge    String
  audience     String
  scopes       String
  state        String
  expiresAt    DateTime
  @@index([workspaceId])
  @@index([expiresAt])
}

/// Legacy families copied into PairGrant and PairGrantToken by the additive migration.
model PairToken {
  accessHash   String @id
  refreshHash  String @unique
  family       String
  rotated      Boolean @default(false)
  workspaceId  String
  workspace    PairWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  clientName   String
  audience     String
  scopes       String
  expiresAt    DateTime
  @@index([workspaceId])
  @@index([family])
}

model PairProposal {
  id           String @id @default(uuid())
  workspaceId  String
  workspace    PairWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String
  key          String
  fingerprint  String
  draft        Json
  before       Json
  status       String @default("pending")
  createdAt    DateTime @default(now())
  @@unique([workspaceId, clientId, key])
}

model PairBudget {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model PairGrant {
  id          String @id @default(uuid())
  workspaceId String
  workspace   PairWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject     String
  clientId    String
  clientName  String
  scopes      String
  audience    String
  codeHash    String? @unique
  revoked     Boolean @default(false)
  tokens      PairGrantToken[]
  @@index([workspaceId])
}

model PairGrantToken {
  accessHash  String @id
  refreshHash String @unique
  grantId     String
  grant       PairGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  rotated     Boolean @default(false)
  expiresAt   DateTime
  @@index([grantId])
}

// Studio store (docs/design/STUDIO_STORE.md, step 2). Written only through
// src/concept/store/postgres-studio-store.ts with raw SQL inside one
// transaction per apply; the models exist so migrations and types stay in one
// place. Intended grants: prisma/grants/studio-store.sql.

enum TenantKind {
  salon
  demo
  sandbox
  @@map("tenant_kind")
}

model TenantState {
  tenantId  String     @id @map("tenant_id")
  kind      TenantKind @default(salon)
  /// Increments by exactly one per committed apply.
  version   Int        @default(0)
  /// The salon document (DemoState in any version migrateState accepts).
  doc       Json       @db.JsonB
  /// Sandbox tenants only; past it, load returns null.
  expiresAt DateTime?  @map("expires_at") @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  @@map("tenant_state")
}

model TenantAction {
  tenantId         String    @map("tenant_id")
  seq              BigInt
  action           Json      @db.JsonB
  actor            String
  source           String
  at               DateTime  @db.Timestamptz(3)
  /// Informational only; replay is decided by tenant_idempotency.
  idempotencyKey   String?   @map("idempotency_key")
  resultingVersion Int       @map("resulting_version")
  /// Customer ids named by the action, for erasure lookups.
  subjectIds       String[]  @default([]) @map("subject_ids")
  redactedAt       DateTime? @map("redacted_at") @db.Timestamptz(3)
  @@id([tenantId, seq])
  @@index([subjectIds], type: Gin)
  @@map("tenant_action")
}

model TenantIdempotency {
  tenantId        String   @map("tenant_id")
  key             String
  /// HMAC-SHA256 of the canonical action under a server secret.
  fingerprintHmac String   @map("fingerprint_hmac")
  seq             BigInt
  /// The first result (state, version, entry, effects) for an exact replay.
  result          Json     @db.JsonB
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  @@id([tenantId, key])
  @@index([expiresAt])
  @@map("tenant_idempotency")
}

model TenantEffect {
  tenantId      String    @map("tenant_id")
  seq           BigInt
  n             Int
  /// Globally unique, from the tenant and the full provider idempotency key; the provider's idempotency key.
  id            String    @unique
  /// SHA-256 of the full provider request, so a reused key with other content is a conflict, not a replay.
  fingerprint   String
  kind          String
  payload       Json      @db.JsonB
  /// pending | delivered | failed (gave up after the maximum attempts) | cancelled (erasure stopped an unsent message).
  /// A pending row is due at next_attempt_at, which also serves as the delivery lease.
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(3)
  /// Set by a claim, cleared by its outcome: the row is in flight with one deliverer until then.
  leasedUntil   DateTime? @map("leased_until") @db.Timestamptz(3)
  /// An erasure stopped this row: never claimed again.
  erasedAt      DateTime? @map("erased_at") @db.Timestamptz(3)
  @@id([tenantId, seq, n])
  @@index([status, nextAttemptAt])
  @@index([tenantId, status, seq, n])
  @@index([status, tenantId, seq, n])
  @@map("tenant_effect")
}
