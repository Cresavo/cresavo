generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Service {
  id String @id
  businessId String
  name String
  duration Int
  priceOre Int
  buffer Int @default(0)
  active Boolean @default(true)
  version Int @default(1)
  bookings Booking[]
  campaigns Campaign[]
}
model Booking {
  id String @id @default(cuid())
  businessId String
  staffId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  customerName String
  customerEmail String
  customerId String?
  contactRemovedAt DateTime? @db.Timestamptz(3)
  customer Customer? @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  serviceName String @default("")
  priceOre Int @default(0)
  duration Int @default(0)
  buffer Int @default(0)
  status String @default("confirmed")
  version Int @default(1)
  initialStartsAt DateTime? @db.Timestamptz(3)
  initialEndsAt DateTime? @db.Timestamptz(3)
  events BookingEvent[]
  capacityDecisions CapacityDecision[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  idempotencyKey String?
  requestHash String?
  clientKey String?
  emailCapKey String?
  @@unique([businessId, idempotencyKey])
  @@unique([businessId, id])
  @@index([businessId, status, startsAt, id])
  @@index([businessId, customerEmail, createdAt])
  @@index([businessId, clientKey, createdAt])
  @@index([businessId, emailCapKey, createdAt])
  @@index([businessId, customerId, startsAt, id])
}
model Customer {
  id String @id @default(cuid())
  businessId String
  name String
  email String
  phone String?
  archived Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  bookings Booking[]
  contactRemovedAt DateTime? @db.Timestamptz(3)
  dataActions CustomerDataAction[]
  @@unique([businessId, id])
  @@index([businessId, archived, name, id])
}
model Staff {
  id String @id @default(cuid())
  businessId String
  name String
  active Boolean @default(true)
  version Int @default(1)
  serviceIds String[]
  weekly Json
  exceptions Json @default("[]")
  @@index([businessId, active])
}

model CustomerDataAction {
  id String @id @default(cuid())
  businessId String
  customerId String
  actorId String
  action String
  bookingCount Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  actor AdminUser @relation(fields: [businessId, actorId], references: [businessId, id], onDelete: Restrict)
  @@index([businessId, customerId, createdAt, id])
}

model BookingEvent {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  action String
  actorKind String
  actorId String
  previousStart DateTime? @db.Timestamptz(3)
  previousEnd DateTime? @db.Timestamptz(3)
  previousStaffId String?
  nextStart DateTime? @db.Timestamptz(3)
  nextEnd DateTime? @db.Timestamptz(3)
  nextStaffId String?
  @@index([bookingId, createdAt])
}

model WorkspaceRequest {
  id String @id @default(cuid())
  businessId String
  key String
  requestHash String
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([businessId, key])
}

// Local synthetic card channel only; not a customer identity/session table.
model CardBookingAttempt {
  businessId String
  scope String
  requestId String @db.Uuid
  payload Json
  outcome String @default("pending")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([businessId, scope, requestId])
  @@index([businessId, scope, createdAt, requestId])
}
model Campaign {
  id String @id @default(cuid())
  businessId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  title String
  discountPercent Int
  validFrom String
  validUntil String
  published Boolean @default(false)
  capacityDecision CapacityDecision?
  @@unique([businessId, id])
}

model CapacityDecision {
  id String @id @default(cuid())
  businessId String
  bookingId String
  booking Booking @relation(fields: [businessId, bookingId], references: [businessId, id], onDelete: Restrict, map: "CapacityDecision_booking_fk")
  sourceVersion Int
  outcome String
  campaignId String? @unique
  campaign Campaign? @relation(fields: [businessId, campaignId], references: [businessId, id], onDelete: Restrict, map: "CapacityDecision_campaign_fk")
  payloadHash String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([businessId, bookingId, sourceVersion])
  @@unique([businessId, campaignId])
}

model AdminSession {
  id String @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userId String?
  user AdminUser? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
}

model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  businessId String
  active Boolean @default(true)
  credentialVersion Int @default(1)
  sessions AdminSession[]
  dataActions CustomerDataAction[]
  @@unique([businessId, id])
}

model RateLimitBucket {
  key String @id
  generation String
  expiresAt DateTime @db.Timestamptz(3)
  count Int
  @@index([expiresAt])
}
