generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Service {
  id String @id
  businessId String
  name String
  duration Int
  priceOre Int
  bookings Booking[]
  campaigns Campaign[]
}
model Booking {
  id String @id @default(cuid())
  businessId String
  staffId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  customerName String
  customerEmail String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  idempotencyKey String?
  requestHash String?
  clientKey String?
  emailCapKey String?
  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerEmail, createdAt])
  @@index([businessId, clientKey, createdAt])
  @@index([businessId, emailCapKey, createdAt])
}
model Campaign {
  id String @id @default(cuid())
  businessId String
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  title String
  discountPercent Int
  validFrom String
  validUntil String
  published Boolean @default(false)
}

model AdminSession {
  id String @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
}
