# Vercel Container Runtime preserves the supported HTTP wrapper as the only
# entry point. It is a scale-to-zero Function, not a persistent single server.
FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1
COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY . .
# Build does not receive database or session credentials.
RUN export DATABASE_URL=postgresql://build@127.0.0.1:1/build_test \
    && npx prisma generate && npm run build \
    && npm prune --omit=dev --no-fund --no-audit

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 CHECKPOINT_DISABLE=1 PORT=3000
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "scripts/server.mjs", "--hostname", "0.0.0.0"]
