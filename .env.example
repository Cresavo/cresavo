DATABASE_URL="postgresql://booking:booking@localhost:5432/booking_lab?schema=public"
# Provision individual synthetic admins with npm run admin:manage; no shared password fallback.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Only INCREASE this value and restart all servers; lowering it can revalidate old cookies.
ADMIN_SESSION_VERSION="1"
# Socket identity is provided by npm run dev/start. Enable forwarding only from listed proxies.
TRUST_PROXY_IP="0"
# Integration/E2E need a separate local database ending in _test or _demo.

# Required when TRUST_PROXY_IP=1. Comma-separated IPs/CIDRs; never trust the whole internet.
TRUSTED_PROXY_IPS=""
