DATABASE_URL="postgresql://booking:booking@localhost:5432/booking_lab?schema=public"
# Provision individual synthetic admins with npm run admin:manage; no shared password fallback.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Only INCREASE this value and restart all servers; lowering it can revalidate old cookies.
ADMIN_SESSION_VERSION="1"
# Socket identity is provided by npm run dev/start. Enable forwarding only from listed proxies.
TRUST_PROXY_IP="0"
# Integration/E2E need a separate local database ending in _test or _demo.

# Required when TRUST_PROXY_IP=1. Comma-separated IPs/CIDRs; never trust the whole internet.
TRUSTED_PROXY_IPS=""

# Local default. Vercel requires BOOKING_RUNTIME=vercel and RATE_LIMIT_STORE=postgres.
# Never enable Vercel mode on a directly reachable self-hosted server.
BOOKING_RUNTIME="local"
RATE_LIMIT_STORE="memory"

# Owner accounts for real salons (/api/owner/*). Keep "0" on the public demo
# until the pilot gate in docs/QUALITY_SECURITY.md has passed.
OWNER_ACCOUNTS_ENABLED="0"
# In production owner accounts need RATE_LIMIT_STORE="postgres" so every worker shares lock-outs; "1" accepts a single process.
# OWNER_SINGLE_WORKER="0"
# Set "1" only when the e-mail domain for password-reset links has click tracking switched off (Resend tracks per domain).
# OWNER_RESET_TRACKING_OFF="0"
# Required with owner accounts: idempotency fingerprints for the salon store. At least 32 random characters.
STUDIO_STORE_HMAC_SECRET=""
# Public booking pages served from a salon's own data (/boka/<slug> and /api/public/*).
# Keep "0" until the pilot gate has passed; the demo never uses it.
PUBLIC_BOOKING_LIVE="0"

# Private synthetic preview only. Keep disabled for local/product/production use.
# Verify ALL-deployment protection and every alias before enabling.
BOOKING_DEMO_ACCESS="0"
BOOKING_DEMO_PROJECT_ID=""
# SHA256(host:port/database), calculated by the operator; never a password.
BOOKING_DEMO_DATABASE=""

# Separate LOCAL synthetic owner-card profile only (never Vercel/production).
# Requires --admin --workday-card and loopback *_test / *_demo, no write flags.
BOOKING_OWNER_CARD_DEMO="0"
BOOKING_OWNER_WEB_ORIGIN="http://localhost:3197"

# Local A2A synthetic demo only. Refused in production and Vercel.
BOOKING_A2A_DEMO=0

# Public-safe read-only preview: fixture data; no DB; writes return 403. Off by default.
PUBLIC_READONLY=0

# Optional separate synthetic customer channel: local test DB only.
# The test:pair -- --native-codex runner supplies these automatically.
# Never put the private customer receipt/link in a prompt or Git.
# BOOKING_CONSENT_DELIVERY=separate-lab
# BOOKING_CONSENT_INBOX_DIR=<operator-owned private temporary directory>

# Cresavo concept demo: bearer token for the studio's MCP endpoint (/api/concept/mcp).
# Use at least 16 characters. Development has a built-in public test token.
# In production the endpoint refuses calls until a token is configured.
# CONCEPT_MCP_TOKEN=

# Concept demo: secret behind the staff calendar subscription links
# (/api/concept/calendar/<staff>.ics?token=...). At least 16 characters. Unset
# outside production = a development secret; unset in production = the feeds
# are switched off.
# CONCEPT_ICS_SECRET=

# Concept demo: any OpenAI-compatible server instead of the hosted providers,
# e.g. local Ollama. Name at least the fast model; the smart tier falls back to
# it. The key is optional (Ollama needs none). Without these, OPENROUTER_API_KEY,
# OPENAI_API_KEY or ANTHROPIC_API_KEY are used when set; with no key at all
# every AI task runs its rule-based fallback.
# CONCEPT_AI_BASE_URL=http://localhost:11434/v1
# CONCEPT_AI_FAST_MODEL=llama3.1
# CONCEPT_AI_SMART_MODEL=
# CONCEPT_AI_API_KEY=

# Concept demo connections (docs/integrations/README.md). Server-side only:
# never prefix any of these with NEXT_PUBLIC_. Everything is simulated unless
# CONCEPT_CONNECTIONS_LIVE=1 AND a port's provider is selected AND its secrets
# are set. The public demo (NEXT_PUBLIC_CONCEPT_PUBLIC_DEMO=1 or
# PUBLIC_READONLY=1) is always simulated, whatever is set here.
CONCEPT_CONNECTIONS_LIVE=
# Provider per port; empty or "simulated" = simulated.
# sms: twilio | 46elks    email: resend | postmark    payments: stripe
# accounting: fortnox | visma-eaccounting    calendar: google-calendar | microsoft-graph
# listing: google-reserve    social: meta
CONCEPT_SMS_PROVIDER=
CONCEPT_EMAIL_PROVIDER=
CONCEPT_PAYMENTS_PROVIDER=
CONCEPT_ACCOUNTING_PROVIDER=
CONCEPT_CALENDAR_PROVIDER=
CONCEPT_LISTING_PROVIDER=
CONCEPT_SOCIAL_PROVIDER=
# Public https origin that providers call, when the server sits behind a proxy
# (webhook signatures cover the exact URL).
CONCEPT_CONNECTIONS_PUBLIC_ORIGIN=

# SMS: Twilio (secrets: account SID + auth token; sender number or messaging service).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# SMS: 46elks (regional, Nordics). The webhook token is the password in the callback
# URL (https://46elks:<token>@host/...), sent as Basic auth.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_WEBHOOK_TOKEN=
ELKS_FROM=
ELKS_CURRENCY=

# Email: Resend (webhook secret starts with whsec_) or Postmark.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# Payments: Stripe secret or restricted key (sk_/rk_) and webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Accounting: Fortnox or Visma eAccounting (regional, Nordics). OAuth app + refresh token.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REFRESH_TOKEN=
FORTNOX_VOUCHER_SERIES=
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_REFRESH_TOKEN=

# Calendar: Google Calendar or Microsoft Graph. OAuth app + refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_TENANT=
MS_GRAPH_USER=

# Listing: Reserve with Google booking-server credentials (approved partners only).
GOOGLE_RESERVE_BOOKING_USER=
GOOGLE_RESERVE_BOOKING_PASSWORD=

# Social: Meta Page access token and app secret (for appsecret_proof); IDs are not secret.
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
