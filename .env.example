DATABASE_URL="postgresql://booking:booking@localhost:5432/booking_lab?schema=public"
# Provision individual synthetic admins with npm run admin:manage; no shared password fallback.
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Only INCREASE this value and restart all servers; lowering it can revalidate old cookies.
ADMIN_SESSION_VERSION="1"
# Socket identity is provided by npm run dev/start. Enable forwarding only from listed proxies.
TRUST_PROXY_IP="0"
# Integration/E2E need a separate local database ending in _test or _demo.

# Required when TRUST_PROXY_IP=1. Comma-separated IPs/CIDRs; never trust the whole internet.
TRUSTED_PROXY_IPS=""

# Local default. Vercel requires BOOKING_RUNTIME=vercel and RATE_LIMIT_STORE=postgres.
# Never enable Vercel mode on a directly reachable self-hosted server.
BOOKING_RUNTIME="local"
RATE_LIMIT_STORE="memory"

# Private synthetic preview only. Keep disabled for local/product/production use.
# Verify ALL-deployment protection and every alias before enabling.
BOOKING_DEMO_ACCESS="0"
BOOKING_DEMO_PROJECT_ID=""
# SHA256(host:port/database), calculated by the operator; never a password.
BOOKING_DEMO_DATABASE=""

# Separate LOCAL synthetic owner-card profile only (never Vercel/production).
# Requires --admin --workday-card and loopback *_test / *_demo, no write flags.
BOOKING_OWNER_CARD_DEMO="0"
BOOKING_OWNER_WEB_ORIGIN="http://localhost:3197"

# Local A2A synthetic demo only. Refused in production and Vercel.
BOOKING_A2A_DEMO=0

# Public-safe read-only preview: fixture data; no DB; writes return 403. Off by default.
PUBLIC_READONLY=0

# Optional separate synthetic customer channel: local test DB only.
# The test:pair -- --native-codex runner supplies these automatically.
# Never put the private customer receipt/link in a prompt or Git.
# BOOKING_CONSENT_DELIVERY=separate-lab
# BOOKING_CONSENT_INBOX_DIR=<operator-owned private temporary directory>

# Concept demo: bearer token for the studio's MCP endpoint (/api/concept/mcp).
# At least 16 characters. Unset outside production = the public development
# token "flerdo-demo-token"; unset in production = the endpoint refuses calls.
# CONCEPT_MCP_TOKEN=

# Concept demo: secret behind the staff calendar subscription links
# (/api/concept/calendar/<staff>.ics?token=...). At least 16 characters. Unset
# outside production = a development secret; unset in production = the feeds
# are switched off.
# CONCEPT_ICS_SECRET=

# Concept demo: any OpenAI-compatible server instead of the hosted providers,
# e.g. local Ollama. Name at least the fast model; the smart tier falls back to
# it. The key is optional (Ollama needs none). Without these, OPENROUTER_API_KEY,
# OPENAI_API_KEY or ANTHROPIC_API_KEY are used when set; with no key at all
# every AI task runs its rule-based fallback.
# CONCEPT_AI_BASE_URL=http://localhost:11434/v1
# CONCEPT_AI_FAST_MODEL=llama3.1
# CONCEPT_AI_SMART_MODEL=
# CONCEPT_AI_API_KEY=
