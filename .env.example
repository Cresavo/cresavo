DATABASE_URL="postgresql://booking:booking@localhost:5432/booking_lab?schema=public"
ADMIN_PASSWORD="replace-with-a-long-local-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Change this value and restart all server processes to invalidate all admin cookies.
ADMIN_SESSION_VERSION="1"
# Enable only behind a trusted proxy that overwrites X-Real-IP and blocks direct access.
TRUST_PROXY_IP="0"
# Integration/E2E need a separate local database ending in _test or _demo.
